f_fill_cluster(float main_val, float[] source_arr, bool only_one) =>
    int idx = -1
    if array.size(source_arr) > 0
        for i = 0 to array.size(source_arr) - 1
            if math.abs(array.get(source_arr, i) - main_val) < 1e-5
                idx := i
                break
    
    float[] res = array.new_float(0)
    if idx != -1
        int count = only_one ? 9 : 4
        for k = 1 to count
            if idx + k < array.size(source_arr)
                array.push(res, array.get(source_arr, idx + k))
            else
                array.push(res, na)
    res

f_fill_cluster_auto(float main_val, float[] source_arr, bool only_one) =>
    int idx = -1
    if array.size(source_arr) > 0
        for i = 0 to array.size(source_arr) - 1
            if math.abs(array.get(source_arr, i) - main_val) < 1e-5
                idx := i
                break
    
    float[] prevs = array.new_float(0)
    float[] nexts = array.new_float(0)
    if idx != -1
        if only_one
            // 1 Main + 9 Larger (same as manual for now as per user request "1 ana 9 büyük")
            for k = 1 to 9
                if idx + k < array.size(source_arr)
                    array.push(nexts, array.get(source_arr, idx + k))
                else
                    array.push(nexts, na)
        else
            // 3 Smaller + 1 Main + 1 Larger
            for k = 1 to 3
                if idx - k >= 0
                    array.push(prevs, array.get(source_arr, idx - k))
                else
                    array.push(prevs, na)
            if idx + 1 < array.size(source_arr)
                array.push(nexts, array.get(source_arr, idx + 1))
            else
                array.push(nexts, na)
    [prevs, nexts]

f_kama_atr(float src, float n) =>
    float n_eff = math.max(0.01, n)
    int n_i = int(math.ceil(n_eff))
    int loop_len = math.min(n_i, bar_index)
    
    // Volatility calculation with fractional support
    float vol = 0.0
    if loop_len > 0
        for i = 0 to loop_len - 1
            float w = (i + 1) <= n_eff ? 1.0 : (n_eff - i)
            vol += math.abs(src[i] - nz(src[i+1], src[i])) * w
    
    // Direction calculation with interpolation
    int f_n = math.min(int(math.floor(n_eff)), bar_index)
    int c_n = math.min(int(math.ceil(n_eff)), bar_index)
    float frac = n_eff - math.floor(n_eff)
    float val_n = f_n == c_n ? nz(src[f_n], src) : nz(src[f_n], src) * (1.0 - frac) + nz(src[c_n], src) * frac
    float dir = math.abs(src - val_n)
    
    float er = vol == 0 ? 0 : math.min(1.0, dir / vol)
    
    // Adaptive smoothing limits to allow "faster" response for small n
    float fast_alpha = 2.0 / (math.max(1.0, math.min(2.0, n_eff)) + 1.0)
    float slow_alpha = 2.0 / 31.0
    
    float sc = math.pow(er * (fast_alpha - slow_alpha) + slow_alpha, 2)
    var float kama = na
    kama := na(kama) ? src : kama + sc * (src - kama)
    
    // For periods below 1, scale the resulting value to represent fractional range
    n < 1.0 ? kama * n : kama

type FiltState
    float rfilt = na

method upd_filt(FiltState s, float h, float l, float r, float init_val, bool reset) =>
    if reset or na(s.rfilt)
        s.rfilt := init_val
    else
        if h - r > s.rfilt
            s.rfilt := h - r
        if l + r < s.rfilt
            s.rfilt := l + r
    s.rfilt

