                        cur_f := low[off] + r
                if close[off] < cur_f
                    failed := true, break
            if not failed
                best_v := g
                break
    
    p_g_main := best_p
    v_g_main := best_v

    bool only_p = show_peak and not show_valley
    bool only_v = show_valley and not show_peak
    bool both = show_peak and show_valley

    if auto_gamma_mode
        [pp, pn] = f_fill_cluster_auto(p_g_main, p_src_arr, only_p)
        p_g_prevs := pp, p_g_nexts := pn
        [vp, vn] = f_fill_cluster_auto(v_g_main, v_src_arr, only_v)
        v_g_prevs := vp, v_g_nexts := vn
    else
        p_g_prevs := array.new_float(0)
        p_g_nexts := f_fill_cluster(p_g_main, p_src_arr, only_p)
        v_g_prevs := array.new_float(0)
        v_g_nexts := f_fill_cluster(v_g_main, v_src_arr, only_v)

// 5. Final Effective Gammas & Sizes
float p_gamma_val = auto_gamma_mode ? nz(p_g_main, p_gamma_val_manual) : p_gamma_val_manual
float v_gamma_val = auto_gamma_mode ? nz(v_g_main, v_gamma_val_manual) : v_gamma_val_manual
float cur_p_sz = cur_sz_unit * p_gamma_val
float cur_v_sz = cur_sz_unit * v_gamma_val

// 6. Anchor Settling & History
var int settled_p_idx = na
var int settled_v_idx = na
var float last_f_p = na
var float last_f_v = na

f_get_settled_idx(bool is_peak, int lb_mode_idx, int lb_val, float prev_f, float sz_val, int prev_settled, float h_src, float l_src, float c_src, int hb_49, int lb_49, int hb_15, int lb_15, int hb_a, int lb_a) =>
    int off = lb_mode_idx == 0 ? (is_peak ? hb_49 : lb_49) : lb_mode_idx == 1 ? (is_peak ? hb_15 : lb_15) : (is_peak ? hb_a : lb_a)
    int raw_ext_idx = bar_index + off
    int res_idx = prev_settled
    if na(prev_settled) or (bar_index - prev_settled > lb_val)
        res_idx := raw_ext_idx
    else
        float dist_pct = not na(prev_f) ? math.abs(c_src - prev_f) / prev_f * 100 : na
        bool prox_reset = not na(dist_pct) and dist_pct <= auto_prox_threshold
        bool threshold_reset = not na(prev_f) and not na(sz_val) and math.abs(c_src - prev_f) > auto_threshold * sz_val
        if prox_reset or threshold_reset
            res_idx := raw_ext_idx
    res_idx

int lb_mode_idx = lb_mode == "Global (Maksimum)" ? 0 : lb_mode == "Otomatik (Hassasiyet)" ? 1 : 2
settled_p_idx := lb_mode == "Zaman (Manuel Çapa)" ? na : f_get_settled_idx(true, lb_mode_idx, lb_input, last_f_p, cur_p_sz, settled_p_idx, high, low, close, hb_4990, lb_4990, hb_1500, lb_1500, hb_auto, lb_auto)
settled_v_idx := lb_mode == "Zaman (Manuel Çapa)" ? na : f_get_settled_idx(false, lb_mode_idx, lb_input, last_f_v, cur_v_sz, settled_v_idx, high, low, close, hb_4990, lb_4990, hb_1500, lb_1500, hb_auto, lb_auto)

if lb_mode == "Zaman (Manuel Çapa)"
    var int p_time_idx = na
    var int v_time_idx = na
    if time <= p_anchor_time
        p_time_idx := bar_index
    if time <= v_anchor_time
        v_time_idx := bar_index
    settled_p_idx := p_time_idx
    settled_v_idx := v_time_idx

// 7. Filter States
var FiltState fs_p = FiltState.new()
var FiltState fs_v = FiltState.new()

is_p_anc = (bar_index == settled_p_idx) or (ta.change(settled_p_idx) != 0)
is_v_anc = (bar_index == settled_v_idx) or (ta.change(settled_v_idx) != 0)
float init_p_val = high[math.max(0, bar_index - nz(settled_p_idx, bar_index))]
float init_v_val = low[math.max(0, bar_index - nz(settled_v_idx, bar_index))]

is_new_hi = high == ta.highest(high, eff_lb)
is_new_lo = low  == ta.lowest(low, eff_lb)

last_f_p := fs_p.upd_filt(high, low, cur_p_sz, init_p_val, is_p_anc)
last_f_v := fs_v.upd_filt(high, low, cur_v_sz, init_v_val, is_v_anc)

// Visualization
var polyline[] p_pl = array.new<polyline>(0)
var polyline[] v_pl = array.new<polyline>(0)

if barstate.islast
    for pl in p_pl
        polyline.delete(pl)
    for pl in v_pl
        polyline.delete(pl)
    array.clear(p_pl), array.clear(v_pl)
    
    int p_idx_u = settled_p_idx
    int v_idx_u = settled_v_idx

    var float[] dr_p_gammas = array.new_float(0)
    var float[] dr_v_gammas = array.new_float(0)
    array.clear(dr_p_gammas), array.clear(dr_v_gammas)
    
    // Add prevs in reverse to maintain order [Smallest -> Largest]
    if array.size(p_g_prevs) > 0
        for k = array.size(p_g_prevs) - 1 to 0
            val = array.get(p_g_prevs, k)
            if not na(val)
                array.push(dr_p_gammas, val)
    array.push(dr_p_gammas, p_g_main)
    if array.size(p_g_nexts) > 0
        for k = 0 to array.size(p_g_nexts) - 1
            val = array.get(p_g_nexts, k)
            if not na(val)
                array.push(dr_p_gammas, val)

    if array.size(v_g_prevs) > 0
        for k = array.size(v_g_prevs) - 1 to 0
            val = array.get(v_g_prevs, k)
            if not na(val)
                array.push(dr_v_gammas, val)
    array.push(dr_v_gammas, v_g_main)
    if array.size(v_g_nexts) > 0
        for k = 0 to array.size(v_g_nexts) - 1
            val = array.get(v_g_nexts, k)
            if not na(val)
                array.push(dr_v_gammas, val)

    if show_peak and not na(p_idx_u)
        for g_idx = 0 to array.size(dr_p_gammas) - 1
            float g = array.get(dr_p_gammas, g_idx)
            bool is_main = g == p_g_main
            bool is_low = g < p_g_main
            color dr_color = is_main ? color.yellow : is_low ? color.new(peak_color, 50) : color.new(peak_color, 0)
            
            FiltState f_r = FiltState.new()
            chart.point[] pts = array.new<chart.point>(0)
            float cf = na, float pf = na
            int s_idx = math.max(bar_index - 4990, p_idx_u)
            float st = high[bar_index-s_idx]
            bool is_step = vis_style == "Basamaklı (Stepline)"
            for j = s_idx to bar_index
                off = bar_index - j
                cf := f_r.upd_filt(high[off], low[off], cur_sz_unit[off] * g, st, j == s_idx)
                if is_step and not na(pf) and math.abs(pf - cf) > (syminfo.mintick / 10)
                    array.push(pts, chart.point.from_index(j, pf))
                array.push(pts, chart.point.from_index(j, cf))
                pf := cf
            if array.size(pts) > 1
                array.push(p_pl, polyline.new(pts, line_color=dr_color, line_width=filt_width))

    if show_valley and not na(v_idx_u)
        for g_idx = 0 to array.size(dr_v_gammas) - 1
            float g = array.get(dr_v_gammas, g_idx)
            bool is_main = g == v_g_main
            bool is_low = g < v_g_main
            color dr_color = is_main ? color.yellow : is_low ? color.new(valley_color, 50) : color.new(valley_color, 0)
            
            FiltState f_r = FiltState.new()
            chart.point[] pts = array.new<chart.point>(0)
            float cf = na, float pf = na
            int s_idx = math.max(bar_index - 4990, v_idx_u)
            float st = low[bar_index-s_idx]
            bool is_step = vis_style == "Basamaklı (Stepline)"
            for j = s_idx to bar_index
                off = bar_index - j
                cf := f_r.upd_filt(high[off], low[off], cur_sz_unit[off] * g, st, j == s_idx)
                if is_step and not na(pf) and math.abs(pf - cf) > (syminfo.mintick / 10)
                    array.push(pts, chart.point.from_index(j, pf))
                array.push(pts, chart.point.from_index(j, cf))
                pf := cf
            if array.size(pts) > 1
                array.push(v_pl, polyline.new(pts, line_color=dr_color, line_width=filt_width))

// Table
if show_table and barstate.islast
    pos = table_pos == "Top Right" ? position.top_right : table_pos == "Bottom Right" ? position.bottom_right : table_pos == "Top Left" ? position.top_left : table_pos == "Bottom Left" ? position.bottom_left : position.middle_right
    var table info_tab = table.new(pos, 2, 5, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)
    c_bg = color.new(color.gray, 80), c_txt = color.white
    table.cell(info_tab, 0, 0, "💎 Volcanic", bgcolor=color.new(color.black, 40), text_color=color.yellow)
    table.cell(info_tab, 1, 0, "", bgcolor=color.new(color.black, 40))
    table.cell(info_tab, 0, 1, "Parametre", bgcolor=c_bg, text_color=c_txt)
    table.cell(info_tab, 1, 1, "Değer", bgcolor=c_bg, text_color=c_txt)
    p_label = auto_gamma_mode ? "🤖 Oto" : (p_gamma_drawer_sel == "Çekmece 1" ? "G1" : (p_gamma_drawer_sel == "Çekmece 2" ? "G2" : "G3"))
    v_label = auto_gamma_mode ? "🤖 Oto" : (v_gamma_drawer_sel == "Çekmece 1" ? "G1" : (v_gamma_drawer_sel == "Çekmece 2" ? "G2" : "G3"))
    
    str_p_full = ""
    if array.size(p_g_prevs) > 0
        for k = array.size(p_g_prevs) - 1 to 0
            v = array.get(p_g_prevs, k)
            if not na(v)
                str_p_full += str.tostring(v, "#.###") + ", "
    str_p_full += "[" + str.tostring(p_g_main, "#.###") + "]"
    if array.size(p_g_nexts) > 0
        for k = 0 to array.size(p_g_nexts) - 1
            v = array.get(p_g_nexts, k)
            if not na(v)
                str_p_full += ", " + str.tostring(v, "#.###")

    str_v_full = ""
    if array.size(v_g_prevs) > 0
        for k = array.size(v_g_prevs) - 1 to 0
            v = array.get(v_g_prevs, k)
            if not na(v)
                str_v_full += str.tostring(v, "#.###") + ", "
    str_v_full += "[" + str.tostring(v_g_main, "#.###") + "]"
    if array.size(v_g_nexts) > 0
        for k = 0 to array.size(v_g_nexts) - 1
            v = array.get(v_g_nexts, k)
            if not na(v)
                str_v_full += ", " + str.tostring(v, "#.###")

    table.cell(info_tab, 0, 2, "Tepe Cluster", bgcolor=color.new(color.gray, 90), text_color=c_txt)
    table.cell(info_tab, 1, 2, p_label + ": " + str_p_full, bgcolor=color.new(color.gray, 90), text_color=c_txt)
    
    table.cell(info_tab, 0, 3, "Dip Cluster", bgcolor=color.new(color.gray, 90), text_color=c_txt)
    table.cell(info_tab, 1, 3, v_label + ": " + str_v_full, bgcolor=color.new(color.gray, 90), text_color=c_txt)
    
    table.cell(info_tab, 0, 4, "ATR Period", bgcolor=color.new(color.gray, 90), text_color=c_txt)
    table.cell(info_tab, 1, 4, str.tostring(atr_per, "#.###"), bgcolor=color.new(color.gray, 90), text_color=c_txt)

    

var label lp = na
var label lv = na
int p_idx_label = settled_p_idx
int v_idx_label = settled_v_idx
if not na(p_idx_label)
    if na(lp)
        lp := label.new(p_idx_label, high[bar_index - p_idx_label], "⚓ Tepe", color=peak_color, textcolor=color.white, style=label.style_label_down)
    else
        label.set_xy(lp, p_idx_label, high[bar_index - p_idx_label])
if not na(v_idx_label)
    if na(lv)
        lv := label.new(v_idx_label, low[bar_index - v_idx_label], "⚓ Dip", color=valley_color, textcolor=color.white, style=label.style_label_up)
    else
        label.set_xy(lv, v_idx_label, low[bar_index - v_idx_label])


alertcondition(settled_p_idx != settled_p_idx[1], "Yeni Tepe", "Otomatik çapa yeni bir tepe noktasına sabitlendi!")
alertcondition(settled_v_idx != settled_v_idx[1], "Yeni Dip", "Otomatik çapa yeni bir dip noktasına sabitlendi!")
